{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "工作流配置",
  "type": "object",
  "required": ["workflow"],
  "properties": {
    "workflow": {
      "type": "object",
      "required": ["name", "tasks"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "version": {"type": "string", "default": "1.0"},
        "config": {"type": "object"},
        "tasks": {"type": "array", "items": {"$ref": "#/definitions/WorkflowTask"}}
      }
    }
  },
  "definitions": {
    "WorkflowTask": {
      "type": "object",
      "required": ["type", "task_id"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["sequential", "parallel", "conditional", "loop"]},
        "task_id": {"type": "string"},
        "config": {"type": "object"},
        "next_tasks": {"type": "array", "items": {"type": "string"}},
        "conditions": {"type": "object"},
        "loop_config": {"type": "object"}
      }
    }
  }
}